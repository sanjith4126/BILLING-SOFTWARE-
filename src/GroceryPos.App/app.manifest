<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="GroceryPos.App"/>

  <!-- Supported OS list. Windows 7 is the deployment target; the later
       entries stop Windows applying compatibility shims on newer machines. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <!-- DPI awareness is deliberately NOT declared here.

       .NET Framework 4.8 WinForms has no per-monitor DPI layout engine, so a
       DPI-aware process receives real pixels but keeps laying out at 96 DPI:
       on a 150%% display every window comes out two-thirds of its intended
       size with the content clipped. Letting Windows bitmap-stretch the window
       instead gives slightly softer text but correct proportions, which is the
       right trade for a shop counter.

       Revisit only if this is ever ported off .NET Framework. -->

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
